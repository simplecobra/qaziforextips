//@version=6
indicator("QFT Sessions & Killzones [ICT]", "QFT Sessions & KZ", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ───────────────────────────────────────────────────────────── inputs
G1 = "Sessions"
showDays   = input.int(5, "Days to show", minval = 1, maxval = 60, group = G1)
showAsia   = input.bool(true, "Asia (Tokyo) session", group = G1)
showLon    = input.bool(true, "London session", group = G1)
showNY     = input.bool(true, "New York session", group = G1)
showRange  = input.bool(true, "Session range in pips", group = G1)
boxTransp  = input.int(88, "Box transparency (0-100)", minval = 40, maxval = 98, group = G1)
cAsia      = input.color(color.rgb(72, 132, 214), "Asia colour", group = G1)
cLon       = input.color(color.rgb(0, 166, 147), "London colour", group = G1)
cNY        = input.color(color.rgb(231, 185, 79), "New York colour", group = G1)

G2 = "ICT killzones (New York time)"
showKZ     = input.bool(true, "Killzone strip at the bottom", group = G2)
cKZA       = input.color(color.rgb(72, 132, 214), "Asian KZ 20:00-00:00", group = G2)
cKZL       = input.color(color.rgb(0, 166, 147), "London KZ 02:00-05:00", group = G2)
cKZN       = input.color(color.rgb(231, 185, 79), "New York KZ 07:00-10:00", group = G2)
cKZC       = input.color(color.rgb(194, 59, 85), "London Close KZ 10:00-12:00", group = G2)

G3 = "Setups: liquidity sweep -> MSS -> entry"
showSetups = input.bool(true, "Mark setups (M1 - M30)", group = G3)
setLon     = input.bool(true, "Setups in London KZ", group = G3)
setNY      = input.bool(true, "Setups in New York KZ", group = G3)
setLC      = input.bool(true, "Setups in London Close KZ", group = G3)
setAsia    = input.bool(false, "Setups in Asian KZ", group = G3)
setAny     = input.bool(false, "Setups at any time (ignore killzones)", group = G3)
setDays    = input.int(10, "Days of setups", minval = 1, maxval = 60, group = G3)
swingLen   = input.int(3, "Swing strength (candles each side)", minval = 2, maxval = 10, group = G3)
liqLook    = input.int(60, "Look back for liquidity (candles)", minval = 10, maxval = 300, group = G3)
mssBars    = input.int(12, "MSS within N candles of the sweep", minval = 2, maxval = 50, group = G3)
dispATR    = input.float(0.3, "MSS candle body at least (x ATR)", minval = 0.0, step = 0.05, group = G3)
minRR      = input.float(2.0, "Minimum reward : risk", minval = 1.0, step = 0.5, group = G3)
targetLook = input.int(300, "Look back for target liquidity (candles)", minval = 20, maxval = 480, group = G3)
slBufATR   = input.float(0.10, "Stop loss buffer beyond the sweep (x ATR)", minval = 0.0, step = 0.05, group = G3)
trailBars  = input.int(3, "After the target: exit on a close beyond the last N candles", minval = 1, maxval = 10, group = G3)

G4 = "Levels and panel"
showPD     = input.bool(true, "Previous day high / low", group = G4)
cPD        = input.color(color.rgb(231, 185, 79), "Previous day colour", group = G4)
showPanel  = input.bool(true, "Session clock panel", group = G4)
clockTZ    = input.string("Pakistan (PKT)", "Clock time zone", options = ["Pakistan (PKT)", "India (IST)", "UTC", "New York", "London"], group = G4)
panelPos   = input.string("Bottom right", "Panel position", options = ["Top left", "Top right", "Bottom left", "Bottom right"], group = G4)

// ───────────────────────────────────────────────────────────── helpers
int   tfSec   = timeframe.in_seconds()
bool  intraday = tfSec <= 3600
int   digits  = int(math.round(math.log10(syminfo.pricescale)))
float pip     = str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD") ? 0.1 : (digits == 3 or digits == 5) ? syminfo.mintick * 10 : syminfo.mintick
string fmtPx  = format.mintick
int   showFrom = last_bar_time - showDays * 86400000
int   setFrom  = last_bar_time - setDays * 86400000

f_tzName() => clockTZ == "Pakistan (PKT)" ? "Asia/Karachi" : clockTZ == "India (IST)" ? "Asia/Kolkata" : clockTZ == "New York" ? "America/New_York" : clockTZ == "London" ? "Europe/London" : "UTC"
f_tzShort() => clockTZ == "Pakistan (PKT)" ? "PKT" : clockTZ == "India (IST)" ? "IST" : clockTZ == "New York" ? "NY" : clockTZ == "London" ? "LDN" : "UTC"

// session membership (TradingView applies each city's daylight saving automatically)
bool inAsia = not na(time(timeframe.period, "0900-1800:23456", "Asia/Tokyo"))
bool inLon  = not na(time(timeframe.period, "0800-1700:23456", "Europe/London"))
bool inNY   = not na(time(timeframe.period, "0800-1700:23456", "America/New_York"))

bool kzA = not na(time(timeframe.period, "2000-0000:12345", "America/New_York"))
bool kzL = not na(time(timeframe.period, "0200-0500:23456", "America/New_York"))
bool kzN = not na(time(timeframe.period, "0700-1000:23456", "America/New_York"))
bool kzC = not na(time(timeframe.period, "1000-1200:23456", "America/New_York"))
int  kzId = kzL ? 1 : kzN ? 2 : kzC ? 3 : kzA ? 0 : -1

f_kzName(int id) => id == 0 ? "Asian KZ" : id == 1 ? "London KZ" : id == 2 ? "New York KZ" : id == 3 ? "London Close" : "Setup"
f_sessName(int z) => z == 0 ? "Asia" : z == 1 ? "London" : "New York"

// ───────────────────────────────────────────────────────────── killzone strip
plotshape(showKZ and intraday and kzA, "Asian KZ", shape.square, location.bottom, color.new(cKZA, 20), size = size.tiny)
plotshape(showKZ and intraday and kzL, "London KZ", shape.square, location.bottom, color.new(cKZL, 20), size = size.tiny)
plotshape(showKZ and intraday and kzN, "New York KZ", shape.square, location.bottom, color.new(cKZN, 20), size = size.tiny)
plotshape(showKZ and intraday and kzC, "London Close KZ", shape.square, location.bottom, color.new(cKZC, 20), size = size.tiny)

// ───────────────────────────────────────────────────────────── sessions
type Sess
    int   z
    int   t0
    float hi
    float lo
    int   hiBar
    int   loBar
    bool  hiTaken
    bool  loTaken
    bool  active
    box   bx
    label lb

var array<Sess> sessions = array.new<Sess>()
var array<Sess> cur = array.from(Sess.new(0, na, na, na, na, na, false, false, false, na, na), Sess.new(1, na, na, na, na, na, false, false, false, na, na), Sess.new(2, na, na, na, na, na, false, false, false, na, na))

f_sessColor(int z) => z == 0 ? cAsia : z == 1 ? cLon : cNY
f_sessShow(int z) => z == 0 ? showAsia : z == 1 ? showLon : showNY

// ───────────────────────────────────────────────────────────── swings
type Swing
    float px
    int   b
    bool  taken

var array<Swing> swH = array.new<Swing>()
var array<Swing> swL = array.new<Swing>()
float pvH = ta.pivothigh(high, swingLen, swingLen)
float pvL = ta.pivotlow(low, swingLen, swingLen)
float atr = ta.sma(ta.tr(true), 14)
float hh11 = ta.highest(high, 11)
int   hb11 = ta.highestbars(high, 11)
float ll11 = ta.lowest(low, 11)
int   lb11 = ta.lowestbars(low, 11)

// ───────────────────────────────────────────────────────────── setups
type Pend
    bool   bull
    int    sb
    float  ext
    float  swp
    float  ref
    int    refBar
    float  liq
    int    liqBar
    string liqName
    Sess   sx
    int    kzInst
    int    kzid
    float  atrS

type Setup
    bool   bull
    int    kzid
    int    mBar
    int    mTime
    float  entry
    float  sl
    float  tp
    float  minTP
    float  tgtRR
    string tpName
    string liqName
    int    phase
    float  rr
    int    result
    float  exitPx
    int    exitTime
    box    bRw
    box    bRk
    line   lEn
    line   lMin
    label  lRes
    line   lExit

var array<Pend>  pend   = array.new<Pend>()
var array<Setup> setups = array.new<Setup>()
var int kzInst = 0
var int lastSetupInst = -1
if kzId != kzId[1] and kzId >= 0
    kzInst += 1

f_kzAllowed(int id) => id == 0 ? setAsia : id == 1 ? setLon : id == 2 ? setNY : id == 3 ? setLC : false

bullC = color.rgb(0, 166, 147)
bearC = color.rgb(224, 72, 94)
goldC = color.rgb(214, 160, 40)

f_resText(Setup s) =>
    string side = s.bull ? "BUY" : "SELL"
    s.result == 1 ? side + "  WIN +" + str.tostring(s.rr, "#.0") + "R" : s.result == 2 ? side + "  LOSS -1R" : side + "  OPEN" + (s.rr > 0 ? " +" + str.tostring(s.rr, "#.0") + "R locked" : "")

f_tip(Setup s) =>
    (s.bull ? "BUY " : "SELL ") + f_kzName(s.kzid) + " | entry " + str.tostring(s.entry, fmtPx) + " (MSS close) | SL " + str.tostring(s.sl, fmtPx) + " | min target 1:" + str.tostring(minRR, "#.0") + " | target " + str.tostring(s.tp, fmtPx) + " (1:" + str.tostring(s.tgtRR, "#.0") + ", " + s.tpName + ") | liquidity swept: " + s.liqName

bool doSetups = showSetups and tfSec <= 1800 and barstate.isconfirmed and time >= setFrom - 2 * 86400000

if doSetups
    // 1) pending sweeps -> market structure shift
    if pend.size() > 0
        for k = pend.size() - 1 to 0
            Pend p = pend.get(k)
            bool drop = bar_index > p.sb + mssBars or (not setAny and p.kzInst == lastSetupInst)
            if not drop
                if p.bull
                    p.ext := math.min(p.ext, low)
                    if close > p.ref
                        drop := true
                        if math.abs(close - open) >= dispATR * atr
                            float sl = p.ext - slBufATR * p.atrS
                            float risk = close - sl
                            if risk > 0
                                float mt = close + minRR * risk
                                float tgt = na
                                string tn = "1:" + str.tostring(minRR, "#.0")
                                if not na(p.sx)
                                    float o = p.sx.active ? math.max(p.sx.hi, high) : p.sx.hi
                                    if o >= mt
                                        tgt := o
                                        tn := f_sessName(p.sx.z) + " high"
                                if na(tgt)
                                    for s in sessions
                                        if not na(s.hi) and time - s.t0 <= 36 * 3600000 and s.t0 < time
                                            float o = s.active ? math.max(s.hi, high) : s.hi
                                            if o >= mt and (na(tgt) or o < tgt)
                                                tgt := o
                                                tn := f_sessName(s.z) + " high"
                                if na(tgt) and swH.size() > 0
                                    for j = swH.size() - 1 to 0
                                        Swing w = swH.get(j)
                                        if w.b < bar_index - targetLook
                                            break
                                        if not w.taken and w.px > high and w.px >= mt
                                            tgt := w.px
                                            tn := "next liquidity"
                                            break
                                if na(tgt)
                                    tgt := mt
                                setups.push(Setup.new(true, p.kzid, bar_index, time, close, sl, tgt, mt, (tgt - close) / risk, tn, p.liqName, 0, 0.0, 4, na, na, na, na, na, na, na, na))
                                lastSetupInst := p.kzInst
                                if time >= setFrom
                                    line.new(p.liqBar, p.liq, p.sb + 1, p.liq, xloc.bar_index, color = color.new(goldC, 15), style = line.style_dotted)
                                    label.new(p.sb, p.swp, "sweep", xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_label_up, goldC, size.tiny, tooltip = "Sweep of the " + p.liqName + ": price took the liquidity and closed back inside")
                                    line.new(p.refBar, p.ref, bar_index + 1, p.ref, xloc.bar_index, color = bullC, width = 2)
                else
                    p.ext := math.max(p.ext, high)
                    if close < p.ref
                        drop := true
                        if math.abs(close - open) >= dispATR * atr
                            float sl = p.ext + slBufATR * p.atrS
                            float risk = sl - close
                            if risk > 0
                                float mt = close - minRR * risk
                                float tgt = na
                                string tn = "1:" + str.tostring(minRR, "#.0")
                                if not na(p.sx)
                                    float o = p.sx.active ? math.min(p.sx.lo, low) : p.sx.lo
                                    if o <= mt
                                        tgt := o
                                        tn := f_sessName(p.sx.z) + " low"
                                if na(tgt)
                                    for s in sessions
                                        if not na(s.lo) and time - s.t0 <= 36 * 3600000 and s.t0 < time
                                            float o = s.active ? math.min(s.lo, low) : s.lo
                                            if o <= mt and (na(tgt) or o > tgt)
                                                tgt := o
                                                tn := f_sessName(s.z) + " low"
                                if na(tgt) and swL.size() > 0
                                    for j = swL.size() - 1 to 0
                                        Swing w = swL.get(j)
                                        if w.b < bar_index - targetLook
                                            break
                                        if not w.taken and w.px < low and w.px <= mt
                                            tgt := w.px
                                            tn := "next liquidity"
                                            break
                                if na(tgt)
                                    tgt := mt
                                setups.push(Setup.new(false, p.kzid, bar_index, time, close, sl, tgt, mt, (close - tgt) / risk, tn, p.liqName, 0, 0.0, 4, na, na, na, na, na, na, na, na))
                                lastSetupInst := p.kzInst
                                if time >= setFrom
                                    line.new(p.liqBar, p.liq, p.sb + 1, p.liq, xloc.bar_index, color = color.new(goldC, 15), style = line.style_dotted)
                                    label.new(p.sb, p.swp, "sweep", xloc.bar_index, yloc.price, color.new(color.black, 100), label.style_label_down, goldC, size.tiny, tooltip = "Sweep of the " + p.liqName + ": price took the liquidity and closed back inside")
                                    line.new(p.refBar, p.ref, bar_index + 1, p.ref, xloc.bar_index, color = bearC, width = 2)
            if drop
                pend.remove(k)
    // one setup per killzone: drop the other pending sweeps of a killzone that just got its setup
    if pend.size() > 0 and not setAny
        for k = pend.size() - 1 to 0
            if pend.get(k).kzInst == lastSetupInst
                pend.remove(k)

    // 2) a new sweep on this candle?
    bool inWin = setAny or (kzId >= 0 and f_kzAllowed(kzId))
    if inWin and (setAny or kzInst != lastSetupInst)
        for side = 0 to 1
            bool bull = side == 0
            float lv = na
            int lb = na
            string ln = ""
            Sess lsx = na
            // a) session highs / lows not taken yet
            for s in sessions
                if not na(s.hi) and s.t0 < time and time - s.t0 <= 36 * 3600000
                    if bull and not s.loTaken and low < s.lo and close > s.lo and (na(lv) or s.lo < lv)
                        lv := s.lo
                        lb := s.loBar
                        lsx := s
                        ln := f_sessName(s.z) + " low"
                    if not bull and not s.hiTaken and high > s.hi and close < s.hi and (na(lv) or s.hi > lv)
                        lv := s.hi
                        lb := s.hiBar
                        lsx := s
                        ln := f_sessName(s.z) + " high"
            // b) swing highs / lows not taken yet
            if na(lv)
                array<Swing> arr = bull ? swL : swH
                if arr.size() > 0
                    for j = arr.size() - 1 to 0
                        Swing w = arr.get(j)
                        if w.b < bar_index - liqLook
                            break
                        if not w.taken
                            if bull and low < w.px and close > w.px and (na(lv) or w.px < lv)
                                lv := w.px
                                lb := w.b
                                ln := "swing low"
                            if not bull and high > w.px and close < w.px and (na(lv) or w.px > lv)
                                lv := w.px
                                lb := w.b
                                ln := "swing high"
            if not na(lv)
                // the swing on the other side that must break (MSS level)
                float ref = na
                int rb = na
                if bull
                    if not na(pvH) and bar_index - swingLen >= bar_index - liqLook
                        ref := pvH
                        rb := bar_index - swingLen
                    else if swH.size() > 0 and swH.last().b >= bar_index - liqLook
                        ref := swH.last().px
                        rb := swH.last().b
                    else
                        ref := hh11
                        rb := bar_index + hb11
                else
                    if not na(pvL) and bar_index - swingLen >= bar_index - liqLook
                        ref := pvL
                        rb := bar_index - swingLen
                    else if swL.size() > 0 and swL.last().b >= bar_index - liqLook
                        ref := swL.last().px
                        rb := swL.last().b
                    else
                        ref := ll11
                        rb := bar_index + lb11
                if (bull and ref > close) or (not bull and ref < close)
                    pend.push(Pend.new(bull, bar_index, bull ? low : high, bull ? low : high, ref, rb, lv, lb, ln, lsx, kzInst, setAny ? -1 : kzId, atr))

// 3) update sessions and swings with this candle
array<bool> inS = array.from(inAsia, inLon, inNY)
for z = 0 to 2
    Sess c = cur.get(z)
    bool now = inS.get(z)
    if now and not c.active
        Sess n = Sess.new(z, time, high, low, bar_index, bar_index, false, false, true, na, na)
        if f_sessShow(z) and intraday and time >= showFrom
            n.bx := box.new(time, high, time + tfSec * 1000, low, color.new(f_sessColor(z), 45), 1, line.style_dotted, extend.none, xloc.bar_time, color.new(f_sessColor(z), boxTransp))
            if showRange
                n.lb := label.new(time, high, "", xloc.bar_time, yloc.price, color.new(color.black, 100), label.style_label_lower_left, f_sessColor(z), size.small)
        sessions.push(n)
        if sessions.size() > 12
            Sess old = sessions.shift()
        cur.set(z, n)
        c := n
    else if now and c.active
        if high > c.hi
            c.hi := high
            c.hiBar := bar_index
            c.hiTaken := false
        if low < c.lo
            c.lo := low
            c.loBar := bar_index
            c.loTaken := false
    else if not now and c.active
        c.active := false
    if now and not na(c.bx)
        c.bx.set_top(c.hi)
        c.bx.set_bottom(c.lo)
        c.bx.set_right(time + tfSec * 1000)
        if not na(c.lb)
            c.lb.set_xy(c.t0, c.hi)
            c.lb.set_text(str.upper(f_sessName(z)) + "  " + str.tostring((c.hi - c.lo) / pip, "#.0") + " pips")
            c.lb.set_tooltip(f_sessName(z) + " session | high " + str.tostring(c.hi, fmtPx) + " | low " + str.tostring(c.lo, fmtPx))

for s in sessions
    if not na(s.hi)
        if bar_index > s.hiBar and high > s.hi
            s.hiTaken := true
        if bar_index > s.loBar and low < s.lo
            s.loTaken := true
for w in swH
    if not w.taken and high > w.px
        w.taken := true
for w in swL
    if not w.taken and low < w.px
        w.taken := true
if not na(pvH)
    swH.push(Swing.new(pvH, bar_index - swingLen, false))
    if swH.size() > 300
        swH.shift()
if not na(pvL)
    swL.push(Swing.new(pvL, bar_index - swingLen, false))
    if swL.size() > 300
        swL.shift()

// 4) follow every setup to its result (same counting rules as the MT5 version)
if barstate.isconfirmed and setups.size() > 0
    for s in setups
        if s.result == 4 and bar_index > s.mBar
            if s.phase == 0
                if (s.bull and low <= s.sl) or (not s.bull and high >= s.sl)
                    s.result := 2
                    s.rr := -1
                    s.exitPx := s.sl
                    s.exitTime := time
                else if (s.bull and high >= s.minTP) or (not s.bull and low <= s.minTP)
                    s.phase := 1
                    s.rr := minRR
            if s.phase == 1 and s.result == 4
                if (s.bull and high >= s.tp) or (not s.bull and low <= s.tp)
                    s.phase := 2
                    s.rr := s.tgtRR
                else if (s.bull and low <= s.entry) or (not s.bull and high >= s.entry)
                    s.result := 1
                    s.rr := minRR
                    s.exitPx := s.minTP
                    s.exitTime := time
            if s.phase == 2 and s.result == 4
                float lvl = na
                for q = 1 to trailBars
                    if bar_index - q > s.mBar
                        lvl := s.bull ? (na(lvl) ? low[q] : math.min(lvl, low[q])) : (na(lvl) ? high[q] : math.max(lvl, high[q]))
                if not na(lvl) and ((s.bull and close < lvl) or (not s.bull and close > lvl))
                    float got = s.bull ? (close - s.entry) / (s.entry - s.sl) : (s.entry - close) / (s.sl - s.entry)
                    s.result := 1
                    s.rr := math.max(s.tgtRR, got)
                    s.exitPx := close
                    s.exitTime := time
        // drawing: a position box from the entry to the target and to the stop loss
        if s.mTime >= setFrom
            int tEnd = s.result == 4 ? time + 3 * tfSec * 1000 : s.exitTime + tfSec * 1000
            int t0 = s.mTime + tfSec * 1000
            string tip = f_tip(s)
            if na(s.bRw)
                s.bRw := box.new(t0, s.tp, tEnd, s.entry, na, 0, xloc = xloc.bar_time, bgcolor = color.new(bullC, 84))
                s.bRk := box.new(t0, s.entry, tEnd, s.sl, na, 0, xloc = xloc.bar_time, bgcolor = color.new(bearC, 84))
                s.lEn := line.new(t0, s.entry, tEnd, s.entry, xloc.bar_time, color = color.new(color.gray, 20))
                s.lMin := line.new(t0, s.minTP, tEnd, s.minTP, xloc.bar_time, color = color.new(bullC, 40), style = line.style_dotted)
                s.lRes := label.new(t0, s.sl, "", xloc.bar_time, yloc.price, color.new(color.black, 100), s.bull ? label.style_label_upper_left : label.style_label_lower_left, goldC, size.small)
            s.bRw.set_right(tEnd)
            s.bRk.set_right(tEnd)
            s.lEn.set_x2(tEnd)
            s.lMin.set_x2(tEnd)
            s.lRes.set_text(f_resText(s))
            s.lRes.set_textcolor(s.result == 1 ? bullC : s.result == 2 ? bearC : goldC)
            s.lRes.set_tooltip(tip)
            if s.result == 1 and na(s.lExit) and not na(s.exitPx)
                s.lExit := line.new(tEnd - 2 * tfSec * 1000, s.exitPx, tEnd, s.exitPx, xloc.bar_time, color = bullC, width = 2)
    // alert for a new setup on a live candle
    Setup ls = setups.last()
    if barstate.isrealtime and ls.mBar == bar_index
        alert("QFT setup " + syminfo.ticker + " " + timeframe.period + ": " + (ls.bull ? "BUY " : "SELL ") + f_kzName(ls.kzid) + " | entry " + str.tostring(ls.entry, fmtPx) + " | SL " + str.tostring(ls.sl, fmtPx) + " | TP " + str.tostring(ls.tp, fmtPx) + " (1:" + str.tostring(ls.tgtRR, "#.0") + ")", alert.freq_once_per_bar_close)

// ───────────────────────────────────────────────────────────── previous day high / low
[pdh, pdl, pdt] = request.security(syminfo.tickerid, "D", [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
var line  lPDH = na
var line  lPDL = na
var label tPDH = na
var label tPDL = na
if barstate.islast and showPD and tfSec < 86400 and not na(pdh)
    int x2 = time + 20 * tfSec * 1000
    if na(lPDH)
        lPDH := line.new(pdt, pdh, x2, pdh, xloc.bar_time, color = color.new(cPD, 15), style = line.style_dashed)
        lPDL := line.new(pdt, pdl, x2, pdl, xloc.bar_time, color = color.new(cPD, 15), style = line.style_dashed)
        tPDH := label.new(x2, pdh, "", xloc.bar_time, yloc.price, color.new(color.black, 100), label.style_label_left, cPD, size.small)
        tPDL := label.new(x2, pdl, "", xloc.bar_time, yloc.price, color.new(color.black, 100), label.style_label_left, cPD, size.small)
    lPDH.set_xy1(pdt, pdh)
    lPDH.set_xy2(x2, pdh)
    lPDL.set_xy1(pdt, pdl)
    lPDL.set_xy2(x2, pdl)
    tPDH.set_xy(x2, pdh)
    tPDL.set_xy(x2, pdl)
    tPDH.set_text("PDH " + str.tostring(pdh, fmtPx))
    tPDL.set_text("PDL " + str.tostring(pdl, fmtPx))

// ───────────────────────────────────────────────────────────── panel
f_dur(float sec) =>
    int s = int(math.max(0, sec))
    int h = int(math.floor(s / 3600.0))
    int m = int(math.floor((s % 3600) / 60.0))
    h > 0 ? str.tostring(h) + "h " + str.tostring(m) + "m" : str.tostring(m) + "m"

// status of a daily window in a city's time: [isOpen, secondsToChange]
f_status(string tz, float fromH, float toH, bool asianKZ) =>
    float h = hour(timenow, tz) + minute(timenow, tz) / 60.0 + second(timenow, tz) / 3600.0
    int dw = dayofweek(timenow, tz)
    bool okDay = asianKZ ? (dw >= 1 and dw <= 5) : (dw >= 2 and dw <= 6)
    float endH = toH == 0.0 ? 24.0 : toH
    bool isOpen = okDay and h >= fromH and h < endH
    float secs = 0.0
    if isOpen
        secs := (endH - h) * 3600
    else
        float add = na
        if okDay and h < fromH
            add := fromH - h
        else
            for d = 1 to 7
                int nd = (dw - 1 + d) % 7 + 1
                bool ok2 = asianKZ ? (nd >= 1 and nd <= 5) : (nd >= 2 and nd <= 6)
                if ok2
                    add := (24 - h) + (d - 1) * 24 + fromH
                    break
        secs := add * 3600
    [isOpen, secs]

f_pos() => panelPos == "Top left" ? position.top_left : panelPos == "Top right" ? position.top_right : panelPos == "Bottom left" ? position.bottom_left : position.bottom_right

var table tb = na
if barstate.islast and showPanel
    if na(tb)
        tb := table.new(f_pos(), 2, 8, bgcolor = color.new(color.rgb(16, 22, 38), 5), border_color = color.rgb(231, 185, 79), border_width = 1, frame_color = color.rgb(231, 185, 79), frame_width = 1)
        tb.merge_cells(0, 7, 1, 7)
    color ink = color.rgb(238, 241, 247)
    color mut = color.rgb(154, 164, 186)
    color gold = color.rgb(231, 185, 79)
    color grn = color.rgb(0, 190, 160)
    string tz = f_tzName()
    tb.cell(0, 0, "QFT SESSIONS", text_color = gold, text_halign = text.align_left, text_size = size.normal)
    tb.cell(1, 0, str.format_time(timenow, "EEEE", tz), text_color = mut, text_halign = text.align_right, text_size = size.normal)
    tb.cell(0, 1, str.format_time(timenow, "HH:mm", tz) + " " + f_tzShort(), text_color = ink, text_halign = text.align_left, text_size = size.large)
    tb.cell(1, 1, "", text_size = size.normal)
    array<string> zt = array.from("Asia/Tokyo", "Europe/London", "America/New_York")
    for z = 0 to 2
        [op, sc] = f_status(zt.get(z), z == 0 ? 9.0 : 8.0, z == 0 ? 18.0 : 17.0, false)
        tb.cell(0, 2 + z, "● " + f_sessName(z), text_color = f_sessColor(z), text_halign = text.align_left, text_size = size.normal)
        tb.cell(1, 2 + z, op ? "OPEN · closes in " + f_dur(sc) : "opens in " + f_dur(sc), text_color = op ? grn : mut, text_halign = text.align_right, text_size = size.normal)
    // killzone now or next
    string kzTxt = ""
    float best = 1e12
    array<float> kf = array.from(20.0, 2.0, 7.0, 10.0)
    array<float> kt = array.from(0.0, 5.0, 10.0, 12.0)
    for i = 0 to 3
        [op, sc] = f_status("America/New_York", kf.get(i), kt.get(i), i == 0)
        if op
            kzTxt := f_kzName(i) + " · " + f_dur(sc) + " left"
            best := -1
        else if best >= 0 and sc < best
            best := sc
            kzTxt := "next: " + f_kzName(i) + " in " + f_dur(sc)
    tb.cell(0, 5, "KILLZONE", text_color = mut, text_halign = text.align_left, text_size = size.normal)
    tb.cell(1, 5, kzTxt, text_color = gold, text_halign = text.align_right, text_size = size.normal)
    // setup results of the last N days
    int w = 0
    int l = 0
    float tr = 0.0
    for s in setups
        if s.mTime >= setFrom
            if s.result == 1
                w += 1
                tr += s.rr
            else if s.result == 2
                l += 1
                tr -= 1
    string res = showSetups and tfSec <= 1800 ? str.tostring(w) + "W · " + str.tostring(l) + "L" + (w + l > 0 ? " · " + str.tostring(100.0 * w / (w + l), "#") + "%" : "") + " · " + (tr >= 0 ? "+" : "") + str.tostring(tr, "#.0") + "R" : "M1 - M30 only"
    tb.cell(0, 6, "SETUPS " + str.tostring(setDays) + "D", text_color = mut, text_halign = text.align_left, text_size = size.normal)
    tb.cell(1, 6, res, text_color = tr >= 0 ? grn : color.rgb(240, 84, 104), text_halign = text.align_right, text_size = size.normal)
    tb.cell(0, 7, "Sessions and killzones follow US / UK daylight saving automatically", text_color = mut, text_halign = text.align_left, text_size = size.small)
